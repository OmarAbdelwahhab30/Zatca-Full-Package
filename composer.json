{
    "name": "asas/zatca",
    "description": "ZATCA (FATOORA) e-invoicing integration package: compliance/production onboarding, XML generation, signing via the ZATCA SDK, reporting, certificate lifecycle.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0",
        "illuminate/database": "^9.0|^10.0",
        "illuminate/queue": "^9.0|^10.0",
        "guzzlehttp/guzzle": "^7.2",
        "doctrine/dbal": "^3.6",
        "nesbot/carbon": "^2.0",
        "psr/http-message": "^1.0|^2.0",
        "symfony/process": "^6.0|^5.4"
    },
    "autoload": {
        "psr-4": {
            "Asas\\Zatca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asas\\Zatca\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0",
        "phpunit/phpunit": "^9.5|^10.0",
        "mockery/mockery": "^1.5"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "smoke": "vendor/bin/testbench zatca:sdk-smoke-test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asas\\Zatca\\ZatcaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
